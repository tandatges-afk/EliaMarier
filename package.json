{
  "name": "elia-marier-vps",
  "version": "4.1.0-vps-operations-beta",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check:static": "node scripts/check-static.mjs && npm test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:legacy": "node --test tests/*.test.mjs",
    "validate": "npm run typecheck && npm run test && npm run test:unit && npm run check:static",
    "sync:queue": "node vps/process-sync-queue.mjs",
    "sync:scan": "node vps/enqueue-linked-sources.mjs",
    "db:import": "node vps/import-firebase-json.mjs",
    "test:vps-smoke": "node --test vps/smoke-media.test.mjs",
    "test:elia-v5": "node --experimental-strip-types --test tests/elia-v5-features.test.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "google-auth-library": "^10.0.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
