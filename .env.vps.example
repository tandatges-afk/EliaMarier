# Secrets must remain server-side. Use a separate PostgreSQL database for Élia.
DATABASE_URL=postgresql://elia:REPLACE_PASSWORD@127.0.0.1:5432/elia
ELIA_PG_POOL_MAX=5
ELIA_MEDIA_ROOT=/srv/elia/media
# Reserve free space on media filesystem; 8 GiB default to protect the small 50GB VPS.
ELIA_MEDIA_RESERVE_BYTES=8589934592
ELIA_MEDIA_SIGNING_KEY=REPLACE_WITH_RANDOM_64_HEX
ELIA_MEDIA_URL_TTL_SECONDS=3600
ELIA_USE_X_ACCEL=true
ELIA_SYNC_QUEUE=/srv/elia/sync-queue
AMORRI_ADMIN_UIDS=REPLACE_WITH_OLD_ADMIN_UID
# Retain original keys if old customer/staff links or encrypted archives must keep working.
AMORRI_DELIVERY_LINK_KEY=
AMORRI_STAFF_LINK_KEY=
AMORRI_ARCHIVE_ENCRYPTION_KEY=
DRIVE_VIDEO_SIGNING_SECRET=
# Google Drive stays source-only unless separately migrated to VPS.
DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_MAPS_API_KEY=
