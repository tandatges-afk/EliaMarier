# Élia Marier — second website (isolated from Amorri original).
# GitHub: tandatges-afk/EliaMarier (create the repository first).
# Firebase Project ID: choose available elia-marier-xxxxx (Firebase IDs are globally unique).
# R2 video bucket: elia-marier-private-videos
# R2 concept bucket: elia-marier-concept-photos
# The AMORRI_* variable names below are internal API compatibility names — DO NOT rename them.
# Copy to .env.local and fill values from NEW services. NEVER commit .env.local.
# Firebase Console > Project settings > Your apps > Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Must point to exactly the SAME new Firebase Project + Realtime Database URL.
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=
# Single-line JSON of the NEW Firebase service account, including escaped \n in private_key.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Firebase Console > Authentication > Users: copy the NEW admin user's UID.
AMORRI_ADMIN_UIDS=

# Cloudflare R2. Keep both buckets private.
# Account ID can be reused if same Cloudflare account; bucket names and tokens must be NEW.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PLAYBACK_TTL_SECONDS=3600

# Second bucket for concept images. Requires object read/write scoped to this bucket.
R2_CONCEPT_BUCKET=
R2_CONCEPT_ACCESS_KEY_ID=
R2_CONCEPT_SECRET_ACCESS_KEY=

# Google Drive video source: create/use a service account with permission to NEW folders.
DRIVE_SERVICE_ACCOUNT_JSON=
# Generate brand-new independent signing/encryption keys, do not reuse old keys.
DRIVE_VIDEO_SIGNING_SECRET=
AMORRI_DELIVERY_LINK_KEY=
AMORRI_STAFF_LINK_KEY=
AMORRI_ARCHIVE_ENCRYPTION_KEY=

# Optional Places API (may require billing).
GOOGLE_MAPS_API_KEY=

# Optional: only configure after creating new repo/workflow secrets and validating dry run.
AMORRI_GITHUB_ACTIONS_REPOSITORY=
AMORRI_GITHUB_ACTIONS_DISPATCH_TOKEN=

# Optional UI link to NEW GitHub repository; e.g. tandatges-afk/EliaMarier
NEXT_PUBLIC_GITHUB_REPOSITORY=
